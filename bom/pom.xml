            </dependency>
            <dependency>
                <groupId>pro.deta.orion</groupId>
                <artifactId>agent-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion</groupId>
                <artifactId>agent-session-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion</groupId>
                <artifactId>agent-provisioning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion</groupId>
