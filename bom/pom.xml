                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion.core</groupId>
                <artifactId>schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion.core.ref</groupId>
                <artifactId>reference</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion.core.ref</groupId>
                <artifactId>antlr-parser</artifactId>
