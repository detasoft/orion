                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion.net</groupId>
                <artifactId>git-transport</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pro.deta.orion.tests</groupId>
