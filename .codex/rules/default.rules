prefix_rule(pattern=["make"], decision="allow")
prefix_rule(pattern=["docker", "exec", "orion-external-services"], decision="allow")
prefix_rule(pattern=["docker", "logs"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["tests/external-services/fixture", ["up", "down"]], decision="allow")
prefix_rule(
    pattern=[
        "/bin/zsh",
        "-lc",
        "docker logs --since 20m orion-external-services 2>&1 | rg -i 'chromium|crash|segfault|signal|exited|fatal' | tail -35",
    ],
    decision="allow",
)
prefix_rule(pattern=["mvn", "verify"], decision="allow")
prefix_rule(pattern=["mvn", "clean"], decision="allow")
prefix_rule(pattern=["mvn", "package"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "diff", "--cached", "--check"], decision="allow")
prefix_rule(pattern=["git", "diff", "--cached", "--name-status"], decision="allow")
prefix_rule(pattern=["git", "cherry-pick"], decision="allow")
prefix_rule(pattern=["git", "branch", "-D"], decision="allow")
prefix_rule(pattern=["git", "worktree"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "mvn test -Pdev -T 4 > /tmp/orion-0601-full.log 2>&1"], decision="allow")
