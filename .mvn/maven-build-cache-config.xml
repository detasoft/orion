<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0
                           https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">
    <configuration>
        <enabled>false</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
    </configuration>
    <input>
        <plugins>
            <plugin groupId="org.apache.maven.plugins" artifactId="maven-surefire-plugin">
                <effectivePom>
                    <excludeProperties>
                        <excludeProperty>orion.testDurations.runId</excludeProperty>
                    </excludeProperties>
                </effectivePom>
            </plugin>
            <plugin groupId="org.apache.maven.plugins" artifactId="maven-failsafe-plugin">
                <effectivePom>
                    <excludeProperties>
                        <excludeProperty>orion.testDurations.runId</excludeProperty>
                    </excludeProperties>
                </effectivePom>
            </plugin>
        </plugins>
    </input>
    <executionControl>
        <runAlways>
            <executions>
                <execution groupId="pro.deta.maven" artifactId="rust-maven-plugin">
                    <execIds>
                        <execId>cargo-test-on-clean</execId>
                    </execIds>
                </execution>
            </executions>
        </runAlways>
    </executionControl>
</cache>
