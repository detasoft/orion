<?xml version="1.0" encoding="UTF-8"?>
<orion schemaVersion="2">
  <system>
    <accessControl>
      <users>
        <user id="root">
          <first>Root</first>
          <last>User</last>
          <email>root@orion.pro</email>
          <credentials>
            <credential>
              <type>ARGON2</type>
              <keyId>root-password</keyId>
              <value>root-password-hash</value>
            </credential>
          </credentials>
          <roles>
            <role>ROOT</role>
          </roles>
          <grants/>
        </user>
      </users>
      <roles>
        <role id="ROOT">
          <grants/>
          <grantReferences>
            <grantReference>ALL_REPOSITORY</grantReference>
          </grantReferences>
        </role>
      </roles>
      <grants>
        <grant id="ALL_REPOSITORY">
          <info>
            <expression>
              <key>REPOSITORY</key>
              <value>*</value>
            </expression>
            <expression>
              <key>READ</key>
              <value>true</value>
            </expression>
          </info>
        </grant>
      </grants>
    </accessControl>
    <https>
      <enabled>false</enabled>
      <address>0.0.0.0</address>
      <port>8443</port>
      <publicUrl>https://orion.example.test</publicUrl>
      <identity alias="https-identity" version="1"/>
      <serverIssuerTrustAnchor alias="https-issuer-root" version="1"/>
      <clientAuthentication>disabled</clientAuthentication>
      <clientTrustAnchors>
        <trustAnchor alias="https-client-root" version="1"/>
      </clientTrustAnchors>
      <acme>
        <enabled>false</enabled>
        <directoryUrl>acme://letsencrypt.org/staging</directoryUrl>
        <accountEmail>admin@example.test</accountEmail>
        <domains>
          <domain>orion.example.test</domain>
        </domains>
        <organization>ORION</organization>
        <accountMaterial alias="acme-account" version="1"/>
        <authorizationTimeoutSeconds>60</authorizationTimeoutSeconds>
        <orderTimeoutSeconds>60</orderTimeoutSeconds>
        <agreeToTermsOfService>false</agreeToTermsOfService>
        <allowRequestedDomains>false</allowRequestedDomains>
      </acme>
    </https>
  </system>
  <organizations>
    <organization id="acme">
      <displayName>Acme</displayName>
      <users>
        <user id="alice" enabled="true">
          <first>Alice</first>
          <last>Example</last>
          <email>alice@acme.example</email>
          <credentials>
            <credential>
              <type>ARGON2</type>
              <value>alice-password-hash</value>
            </credential>
          </credentials>
          <memberships>
            <team>platform</team>
          </memberships>
          <roles>
            <role>acme/member</role>
          </roles>
        </user>
        <user id="blocked" enabled="false">
          <credentials/>
          <memberships/>
          <roles/>
        </user>
      </users>
      <grants>
        <grant id="read" effect="ALLOW">
          <expressions>
            <expression>
              <key>READ</key>
              <value>true</value>
            </expression>
          </expressions>
        </grant>
      </grants>
      <roles>
        <role id="member">
          <roleReferences/>
          <grantReferences>
            <grantReference>acme/read</grantReference>
          </grantReferences>
        </role>
      </roles>
      <teams>
        <team id="platform">
          <displayName>Platform</displayName>
          <grants>
            <grant id="deploy" effect="ALLOW">
              <expressions>
                <expression>
                  <key>WRITE</key>
                  <value>true</value>
                </expression>
              </expressions>
            </grant>
          </grants>
          <roles>
            <role id="operator">
              <roleReferences>
                <roleReference>acme/member</roleReference>
              </roleReferences>
              <grantReferences>
                <grantReference>acme/platform/deploy</grantReference>
              </grantReferences>
            </role>
          </roles>
          <repositories>
            <repository id="api">
              <displayName>API</displayName>
              <defaultBranch>refs/heads/main</defaultBranch>
              <policy>
                <allowForcePushes>false</allowForcePushes>
                <allowBranchDeletes>false</allowBranchDeletes>
                <allowTagRewrites>false</allowTagRewrites>
              </policy>
              <remotes>
                <remote alias="upstream">
                  <role>PRIMARY</role>
                  <provider>GITHUB</provider>
                  <uri>https://github.com/acme/api.git</uri>
                  <credential>
                    <scope>REPOSITORY</scope>
                    <reference>github-token</reference>
                  </credential>
                  <triggers>
                    <trigger>STARTUP_RECONCILE</trigger>
                    <trigger>LOCAL_REF_UPDATE</trigger>
                    <trigger>PERIODIC_AUDIT</trigger>
                  </triggers>
                  <refMappings>
                    <refMapping>
                      <source>refs/heads/*</source>
                      <destination>refs/heads/*</destination>
                    </refMapping>
                  </refMappings>
                  <updatePolicy>
                    <allowForceUpdates>false</allowForceUpdates>
                    <allowDeletes>false</allowDeletes>
                    <allowTagRewrites>false</allowTagRewrites>
                  </updatePolicy>
                </remote>
              </remotes>
              <grants>
                <grant id="block-force-push" effect="DENY">
                  <expressions>
                    <expression>
                      <key>FORCE</key>
                      <value>true</value>
                    </expression>
                  </expressions>
                </grant>
              </grants>
              <roles>
                <role id="maintainer">
                  <roleReferences>
                    <roleReference>acme/platform/operator</roleReference>
                  </roleReferences>
                  <grantReferences>
                    <grantReference>acme/platform/api/block-force-push</grantReference>
                  </grantReferences>
                </role>
              </roles>
            </repository>
          </repositories>
        </team>
      </teams>
    </organization>
  </organizations>
</orion>
